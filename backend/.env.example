# LLM Provider Configuration: 'cloud' or 'ollama' or 'mock'
DEFAULT_LLM_PROVIDER=ollama

# Cloud LLM Settings (OpenAI / OpenRouter / Anthropic compatible)
CLOUD_PROVIDER=openai
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest

# Embedding Configuration (Independent from LLM Provider)
# Options: 'ollama' or 'chroma_default' or 'cloud'
EMBEDDING_PROVIDER=chroma_default
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# Knowledge Base & Vector DB
CHROMA_PERSIST_DIRECTORY=backend/knowledge_base/chroma_db
CHROMA_COLLECTION_NAME=cad_knowledge_base
BM25_TOP_K=15
DENSE_TOP_K=15
RERANK_TOP_K=5

# FreeCAD & CAD Execution Runtime
# Set path to FreeCADCmd.exe or freecadcmd executable if not in standard path
FREECAD_BIN_PATH=
CAD_EXECUTION_TIMEOUT_SECONDS=30
MAX_REPAIR_ATTEMPTS=2

# Security & Sandboxing
ALLOW_UNSAFE_EXECUTION=false

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
